#!/usr/bin/env ruby
# Rename source references only. Never read, generate, or overwrite credentials.
require "pathname"

APP_ROOT = Pathname.new(__dir__).parent.realpath
RENAME_FILES = %w[
  config/application.rb
  app/views/pwa/manifest.json.erb
  config/locales/en.yml
  config/locales/auth.en.yml
  docs/testing.md
  docs/authentication.md
  test/controllers/dashboard_controller_test.rb
  test/components/auth/form_container_component_test.rb
  PRD.md
  README.md
  CLAUDE.md
  Dockerfile
  config/deploy.yml
].freeze

name = ARGV.first
unless ARGV.length == 1 && name.match?(/\A[A-Z][a-zA-Z0-9]*\z/)
  abort "Usage: bin/rename-app PascalCaseName (for example: bin/rename-app PsstWeb)"
end

snake_name = name.gsub(/([A-Z]+)([A-Z][a-z])/, '\1_\2')
                 .gsub(/([a-z\d])([A-Z])/, '\1_\2').downcase
replacements = { "RailsStarter" => name, "Rails Starter" => name, "rails_starter" => snake_name }
pattern = Regexp.union(replacements.keys)
files = RENAME_FILES.map { |relative| APP_ROOT.join(relative) }.select(&:exist?)

# Validate all destinations before the first write; never follow a source link
# into another checkout or into files outside the application.
if files.any? { |file| file.symlink? || !file.realpath.to_s.start_with?("#{APP_ROOT}/") }
  abort "Refusing to rename through a symlink or outside the application. No files changed."
end

application = APP_ROOT.join("config/application.rb")
unless application.file? && application.read.match?(/^module RailsStarter$/)
  abort "This application is not an unrenamed RailsStarter. No files changed."
end

files.each do |file|
  content = file.read
  updated = content.gsub(pattern, replacements)
  next if content == updated

  file.write(updated)
  puts "Updated: #{file.relative_path_from(APP_ROOT)}"
end

puts "Renamed application to #{name}. Credentials and databases were left untouched."
puts "Review README.md, CLAUDE.md, and deployment settings, then run bin/setup --skip-server."

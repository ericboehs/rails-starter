#!/usr/bin/env ruby
# Collate the recorded suites with the locked SimpleCov version and enforce
# thresholds on the merged result, rather than scraping an HTML report.
require "bundler/setup"
require "simplecov"

APP_ROOT = File.expand_path("..", __dir__)
result_file = File.join(APP_ROOT, "coverage", ".resultset.json")
abort "No coverage results found. Run bin/rails test first." unless File.file?(result_file)

SimpleCov.collate([ result_file ], "rails") do
  root APP_ROOT
  enable_coverage :branch
  minimum_coverage line: 95, branch: 95
  minimum_coverage_by_file 80
end

result = SimpleCov.result
abort "No application files in coverage results. Run the test suites from this application first." if result.files.empty?
summary = format("Line coverage: %.2f%% | Branch coverage: %.2f%%", result.covered_percent, result.coverage_statistics.fetch(:branch).percent)
puts summary
if ENV["GITHUB_STEP_SUMMARY"]
  File.open(ENV.fetch("GITHUB_STEP_SUMMARY"), "a") { |file| file.puts "\n## Test coverage\n\n#{summary}\n" }
end
